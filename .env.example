# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=

# --- Optional ---
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SEC=120
UPLOAD_TIMEOUT_SEC=300
LOG_LEVEL=INFO

# Netscape-format cookies.txt (last resort for YouTube; use a throwaway account)
COOKIES_FILE=

# Route yt-dlp through a proxy, e.g. a residential proxy on a VPS
# PROXY_URL=http://user:pass@host:port
PROXY_URL=

# PO token provider URL (set automatically by docker-compose; for bare-metal
# runs with a local provider use http://127.0.0.1:4416)
POT_PROVIDER_URL=

# --- Admin & limits ---
# Your numeric Telegram user ID (get it from @userinfobot). Enables /stats,
# /ban <id>, /unban <id>, /broadcast <message>
ADMIN_ID=

# SQLite path (docker-compose overrides this to /data/bot.db)
DB_PATH=bot.db

# Max downloads per user per 24h. 0 = unlimited
DOWNLOADS_PER_DAY=0
