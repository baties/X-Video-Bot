# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=

# --- Optional ---
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SEC=120
UPLOAD_TIMEOUT_SEC=300
LOG_LEVEL=INFO

# Netscape-format cookies.txt (last resort for YouTube; use a throwaway account)
COOKIES_FILE=

# Route yt-dlp through a proxy, e.g. a residential proxy on a VPS
# PROXY_URL=http://user:pass@host:port
PROXY_URL=

# PO token provider URL (set automatically by docker-compose; for bare-metal
# runs with a local provider use http://127.0.0.1:4416)
POT_PROVIDER_URL=

# --- Admin & limits ---
# Your numeric Telegram user ID (get it from @userinfobot). Enables /stats,
# /ban <id>, /unban <id>, /broadcast <message>
ADMIN_ID=

# SQLite path (docker-compose overrides this to /data/bot.db)
DB_PATH=bot.db

# Free plan: FREE_CREDITS renewed every FREE_PERIOD_DAYS for every user
FREE_CREDITS=5
FREE_PERIOD_DAYS=7

# --- Credits & payments ---
# Credit cost per successful download, by platform
CREDIT_COST_X=1
CREDIT_COST_INSTAGRAM=1
CREDIT_COST_YOUTUBE=3

# Max simultaneous downloads across ALL users (protects the VPS + YouTube quota)
MAX_CONCURRENT_DOWNLOADS=3

# Telegram Stars packages as credits:stars pairs
STAR_PACKAGES=5:25,15:70,40:170

# --- VIP & size limits ---
# Max source-video size per tier (MB). Admin is unlimited.
# NOTE: Telegram bots can only UPLOAD up to 50 MB — larger files are
# compressed to fit, so VIP_SIZE_LIMIT_MB above ~100 gets heavy compression.
USER_SIZE_LIMIT_MB=50
VIP_SIZE_LIMIT_MB=100

# VIP membership via Stars (0 stars hides the product)
VIP_PRICE_STARS=150
VIP_DAYS=30

# --- VIP synced transcripts ---
# Required to enable /transcript. Keep this secret; never commit .env.
OPENAI_API_KEY=
# whisper-1 is required for segment timestamps used by synced subtitles.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# Subtitle credits consumed per minute, rounded up (minimum 1 credit/job).
SUBTITLE_CREDIT_PER_MINUTE=2
# Subtitle credits granted on every admin VIP grant or paid VIP purchase.
VIP_SUBTITLE_CREDITS=20
# Burned-in caption appearance. Color accepts a name or #RRGGBB.
SUBTITLE_FONT_SIZE=24
SUBTITLE_FONT_COLOR=white

# --- Logging ---
# Directory for bot.log (app log) and events.log (user/admin event log).
# docker-compose overrides this to /data/logs -> visible on the host in ./data/logs
LOG_DIR=logs
